<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectTypeGuids>{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <Authors>Confluent Inc.;Andreas Heider</Authors>
    <Description>Confluent's .NET Client for Apache Kafka</Description>
    <Copyright>Copyright 2016-2020 Confluent Inc., Andreas Heider</Copyright>
    <PackageProjectUrl>https://github.com/confluentinc/confluent-kafka-dotnet/</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/confluentinc/confluent-kafka-dotnet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>confluent-logo.png</PackageIcon>
    <PackageIconUrl>https://raw.githubusercontent.com/confluentinc/confluent-kafka-dotnet/master/confluent-logo.png</PackageIconUrl>
    <PackageReleaseNotes>https://github.com/confluentinc/confluent-kafka-dotnet/releases</PackageReleaseNotes>
    <PackageTags>Kafka;Confluent;librdkafka</PackageTags>
    <PackageId>Confluent.Kafka</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Title>Confluent.Kafka</Title>
    <AssemblyName>Confluent.Kafka</AssemblyName>
    <TargetFrameworks>$(TargetFrameworks);netstandard2.0;net462</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Confluent.Kafka.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!--
    Single-DLL build support.

    When EmbedLibrdkafka is true (the default), the librdkafka native libraries
    and the managed dependency assemblies (System.Memory etc., only needed by
    the netstandard2.0/net462 targets) are gzip-compressed and embedded into
    Confluent.Kafka.dll as resources instead of being copied next to it. At
    runtime they are extracted / loaded automatically (see
    Impl/EmbeddedLibrdkafka.cs and Impl/EmbeddedAssemblyResolver.cs), so the
    single Confluent.Kafka.dll file is all that needs to be deployed.

    - Set EmbedLibrdkafka=false to restore the stock behaviour.
    - Set EmbedLibrdkafkaRuntimes to a subset (e.g. "win-x64") to reduce the
      size of the resulting assembly.

    Both properties are defaulted in ../Directory.Build.props (sibling projects
    react to EmbedLibrdkafka too, see ../Directory.Build.targets).
  -->
  <PropertyGroup>
    <LibrdkafkaRedistVersion>2.15.0</LibrdkafkaRedistVersion>
    <!--
      Distinguish the self-contained package from the official Confluent.Kafka
      of the same version (same id + version would collide in the NuGet cache).
      Override with -p:PackageVersion=... if needed.
    -->
    <PackageVersion Condition="'$(EmbedLibrdkafka)' == 'true' and '$(PackageVersion)' == ''">$(VersionPrefix).1</PackageVersion>
    <!-- Ensure the managed dependency assemblies show up in ReferenceCopyLocalPaths so they can be embedded. -->
    <CopyLocalLockFileAssemblies Condition="'$(EmbedLibrdkafka)' == 'true'">true</CopyLocalLockFileAssemblies>
    <_EmbedManagedDependencyNames>;System.Memory;System.Buffers;System.Numerics.Vectors;System.Runtime.CompilerServices.Unsafe;</_EmbedManagedDependencyNames>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="LibrdkafkaRedistVersion" Value="$(LibrdkafkaRedistVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="librdkafka.redist" Version="$(LibrdkafkaRedistVersion)" GeneratePathProperty="true">
      <PrivateAssets Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">None</PrivateAssets>
      <ExcludeAssets Condition="'$(EmbedLibrdkafka)' == 'true'">all</ExcludeAssets>
      <PrivateAssets Condition="'$(EmbedLibrdkafka)' == 'true'">all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net462'">
    <!-- With EmbedLibrdkafka these are merged/embedded into the assembly and must not surface as package dependencies. -->
    <PackageReference Include="System.Memory" Version="4.6.3">
      <PrivateAssets Condition="'$(EmbedLibrdkafka)' == 'true'">all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Buffers" Version="4.6.1">
      <PrivateAssets Condition="'$(EmbedLibrdkafka)' == 'true'">all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Allows the net462 target to be built on non-Windows machines. -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net462' and '$(OS)' != 'Windows_NT' ">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    For net462 the managed dependencies are merged into Confluent.Kafka.dll with
    ILRepack rather than embedded as resources: .NET Framework resolves assembly
    references while JIT compiling, which can happen before this assembly's
    module initializer has had a chance to register the AssemblyResolve fallback
    (and a stale System.Memory.dll in the host application then fails the load
    with a ref/def version mismatch). After merging there are no external
    references left to resolve.
  -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net462' and '$(EmbedLibrdkafka)' == 'true' ">
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.46" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\confluent-logo.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <UsingTask TaskName="GZipCompressFiles" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
foreach (var item in Files)
{
    var source = item.GetMetadata("FullPath");
    var destination = item.GetMetadata("Destination");
    if (File.Exists(destination) && File.GetLastWriteTimeUtc(destination) >= File.GetLastWriteTimeUtc(source))
    {
        continue;
    }
    Directory.CreateDirectory(Path.GetDirectoryName(destination));
    // write to a temp file + move so that concurrent inner (per target framework)
    // builds sharing the same destination don't observe partially written files.
    var temp = destination + "." + Guid.NewGuid().ToString("N") + ".tmp";
    using (var input = File.OpenRead(source))
    using (var output = File.Create(temp))
    using (var gzip = new GZipStream(output, CompressionLevel.Optimal))
    {
        input.CopyTo(gzip);
    }
    try
    {
        if (File.Exists(destination))
        {
            File.Delete(destination);
        }
        File.Move(temp, destination);
    }
    catch (IOException)
    {
        // a concurrent build won the race; keep its output.
    }
    finally
    {
        if (File.Exists(temp))
        {
            try { File.Delete(temp); } catch (IOException) { }
        }
    }
}
]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="EmbedSingleFileDependencies"
          Condition="'$(EmbedLibrdkafka)' == 'true'"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ResolveReferences">
    <Error Condition="'$(Pkglibrdkafka_redist)' == ''"
           Text="EmbedLibrdkafka is enabled but the librdkafka.redist package path is unknown. Run a NuGet restore first." />

    <ItemGroup>
      <_LibrdkafkaRid Include="$(EmbedLibrdkafkaRuntimes)" />
      <_LibrdkafkaNative Include="$(Pkglibrdkafka_redist)/runtimes/%(_LibrdkafkaRid.Identity)/native/*">
        <Rid>%(_LibrdkafkaRid.Identity)</Rid>
      </_LibrdkafkaNative>
      <_LibrdkafkaNative>
        <Destination>$(BaseIntermediateOutputPath)librdkafka-embed/%(_LibrdkafkaNative.Rid)/%(Filename)%(Extension).gz</Destination>
        <LogicalName>librdkafka.%(_LibrdkafkaNative.Rid).%(Filename)%(Extension).gz</LogicalName>
      </_LibrdkafkaNative>

      <!-- net462: merged with ILRepack (see MergeManagedDependencies); other targets: embedded as resources. -->
      <_ManagedDep Include="@(ReferenceCopyLocalPaths)"
                   Condition="'%(Extension)' == '.dll' and $(_EmbedManagedDependencyNames.Contains(';%(Filename);'))" />
      <_MergedManagedDep Include="@(_ManagedDep)" Condition="'$(TargetFramework)' == 'net462'" />
      <_EmbeddedManagedDep Include="@(_ManagedDep)" Condition="'$(TargetFramework)' != 'net462'" />
      <_EmbeddedManagedDep>
        <Destination>$(BaseIntermediateOutputPath)managed-embed/$(TargetFramework)/%(Filename)%(Extension).gz</Destination>
        <LogicalName>embedded.assembly.%(Filename)%(Extension).gz</LogicalName>
      </_EmbeddedManagedDep>
    </ItemGroup>

    <GZipCompressFiles Files="@(_LibrdkafkaNative);@(_EmbeddedManagedDep)"
                       Condition="'@(_LibrdkafkaNative)@(_EmbeddedManagedDep)' != ''" />

    <ItemGroup>
      <EmbeddedResource Include="@(_LibrdkafkaNative->'%(Destination)');@(_EmbeddedManagedDep->'%(Destination)')"
                        WithCulture="false"
                        Type="Non-Resx"
                        Visible="false" />
      <!-- The embedded/merged managed dependencies must not be copied next to the output assembly. -->
      <ReferenceCopyLocalPaths Remove="@(_ManagedDep)" />
    </ItemGroup>
  </Target>

  <Target Name="MergeManagedDependencies"
          Condition="'$(TargetFramework)' == 'net462' and '$(EmbedLibrdkafka)' == 'true'"
          AfterTargets="CoreCompile"
          BeforeTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="EmbedSingleFileDependencies"
          Inputs="@(IntermediateAssembly);@(_MergedManagedDep)"
          Outputs="$(IntermediateOutputPath)ilrepack.stamp">
    <PropertyGroup>
      <_ILRepackOutDir>$(IntermediateOutputPath)ilrepack/</_ILRepackOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_ILRepackLibDir Include="@(ReferencePath->'%(RootDir)%(Directory)')" />
      <_ILRepackLibDirDistinct Include="@(_ILRepackLibDir->Distinct())" />
    </ItemGroup>

    <MakeDir Directories="$(_ILRepackOutDir)" />
    <ILRepack Parallel="true"
              InputAssemblies="@(IntermediateAssembly);@(_MergedManagedDep)"
              LibraryPath="@(_ILRepackLibDirDistinct)"
              KeyFile="$(MSBuildProjectDirectory)/$(AssemblyOriginatorKeyFile)"
              XmlDocumentation="true"
              OutputFile="$(_ILRepackOutDir)$(TargetFileName)" />

    <Copy SourceFiles="$(_ILRepackOutDir)$(TargetFileName)" DestinationFiles="@(IntermediateAssembly)" />
    <Copy SourceFiles="$(_ILRepackOutDir)$(AssemblyName).pdb"
          DestinationFiles="@(IntermediateAssembly->'%(RootDir)%(Directory)%(Filename).pdb')"
          Condition="Exists('$(_ILRepackOutDir)$(AssemblyName).pdb')" />
    <Copy SourceFiles="$(_ILRepackOutDir)$(AssemblyName).xml"
          DestinationFiles="@(DocFileItem)"
          Condition="Exists('$(_ILRepackOutDir)$(AssemblyName).xml') and '@(DocFileItem)' != ''" />

    <Touch Files="$(IntermediateOutputPath)ilrepack.stamp" AlwaysCreate="true" />
  </Target>

</Project>
